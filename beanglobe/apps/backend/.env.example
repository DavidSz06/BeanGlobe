# Copy to .env and fill in. .env is gitignored.
# --- backend ---
PORT=5000
NODE_ENV=development

# --- database (Postgres / Supabase) ---
DATABASE_URL=postgresql://user:password@localhost:5432/beanglobe

# --- LLM (tasting-note parser) ---
# Use a cheap model: Anthropic Haiku or Gemini Flash free tier.
LLM_PROVIDER=gemini
LLM_API_KEY=

# --- auth ---
JWT_SECRET=change_me
